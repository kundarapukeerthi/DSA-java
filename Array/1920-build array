class Solution {
    public int[] buildArray(int[] nums) {
        int n=nums.length;
        int[] arr=new int[n];
        for(int i=0;i<n;i++)
        {
            arr[i]=nums[nums[i]];// only that particular index get changed sometimes we may start from 1 so 0th position indexed value will not change.
        }
        return arr;

        
    }
}
