//1732-highest altitude
class Solution {
    public int largestAltitude(int[] gain) {
        int n=gain.length,max=0;
        int[] pref=new int[n+1];
        pref[0]=0;
        for(int i=1;i<=n;i++)
        {
            pref[i]=pref[i-1]+gain[i-1];
        }
        for(int i=0;i<=n;i++)
        {
          max=Math.max(pref[i],max);  
        }
        return max;
        
    }
}
